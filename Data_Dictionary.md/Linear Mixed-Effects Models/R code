import pandas as pd

# ۱. بارگذاری داده‌ها
df = pd.read_csv("data/download_Full_Longitudinal_Dataset_AI_Writing.csv")

# ۲. مشخص کردن ستون‌هایی که نباید تغییر کنند (ثابت‌ها)
id_vars = ["Participant_ID", "Final_Human_Rating", "Status"]

# ۳. لیست کردن ستون‌های تکرارشونده طولی
value_vars = [col for col in df.columns if col not in id_vars]

# ۴. تبدیل داده از Wide به فرمت میانی طولی
df_melted = df.melt(
    id_vars=id_vars, 
    value_vars=value_vars, 
    var_name="Metric_Stage", 
    value_name="Value"
)

# ۵. تفکیک نام شاخص و زمان (مثال: MTLD_Pre به شاخص MTLD و زمان Pre)
df_melted[["Metric", "Stage"]] = df_melted["Metric_Stage"].str.rsplit("_", n=1, expand=True)

# ۶. سازماندهی نهایی به طوری که هر شاخص یک ستون مجزا داشته باشد
df_long = df_melted.pivot(
    index=["Participant_ID", "Final_Human_Rating", "Status", "Stage"],
    columns="Metric",
    values="Value"
).reset_index()

# نمایش نمونه‌ای از داده‌های نهایی تغییر شکل یافته
print(df_long.head())
